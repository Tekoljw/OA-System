import React from "react";
import PageLayout from "@/components/layout/PageLayout";
import FeatureSyncManager from "@/components/configurations/FeatureSyncManager";
import { useAuth } from "@/contexts/AuthContext";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert";
import { ShieldAlert, Info } from "lucide-react";

const FeatureSync = () => {
  const { user, currentProject } = useAuth();
  const isSuperAdmin = user?.isSuperAdmin || false;

  return (
    <PageLayout title="功能同步" subtitle="在所有项目之间同步功能配置">
      {!isSuperAdmin ? (
        <Alert variant="destructive" className="mb-4">
          <ShieldAlert className="h-4 w-4" />
          <AlertTitle>权限不足</AlertTitle>
          <AlertDescription>
            只有超级管理员可以访问功能同步功能。
          </AlertDescription>
        </Alert>
      ) : (
        <>
          <Alert className="mb-4">
            <Info className="h-4 w-4" />
            <AlertTitle>功能同步说明</AlertTitle>
            <AlertDescription>
              功能同步允许您将当前项目的配置同步到其他所有项目中。
              这对于确保各项目之间配置的一致性非常有用。
              同步将覆盖目标项目中的相应配置，请谨慎操作。
            </AlertDescription>
          </Alert>

          <Card className="mb-4">
            <CardHeader>
              <CardTitle>当前源项目</CardTitle>
              <CardDescription>
                以下配置将从当前项目同步到其他所有项目
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <span className="font-medium">项目名称:</span>
                </div>
                <div>{currentProject?.name}</div>
                <div>
                  <span className="font-medium">项目代码:</span>
                </div>
                <div>{currentProject?.code}</div>
                <div>
                  <span className="font-medium">项目描述:</span>
                </div>
                <div>{currentProject?.description || "无描述"}</div>
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>功能同步管理</CardTitle>
              <CardDescription>
                选择要同步的功能，并将其同步到所有其他项目
              </CardDescription>
            </CardHeader>
            <CardContent>
              <FeatureSyncManager />
            </CardContent>
          </Card>
        </>
      )}
    </PageLayout>
  );
};

export default FeatureSync;