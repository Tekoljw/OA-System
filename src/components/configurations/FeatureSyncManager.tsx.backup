import { useState, useEffect } from 'react';
import { useAuth } from '@/contexts/AuthContext';
import { apiRequest } from '@/utils/api';
import { Button } from '@/components/ui/button';
import { 
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select';
import {
  Alert,
  AlertDescription,
  AlertTitle,
} from '@/components/ui/alert';
import {
  CheckCircle2,
  XCircle,
  AlertTriangle,
  RefreshCw,
  Info
} from 'lucide-react';
import { useToast } from '@/hooks/use-toast';
import { 
  Card, 
  CardContent, 
  CardHeader, 
  CardTitle 
} from '@/components/ui/card';

interface Feature {
  id: string;
  name: string;
  table: string;
}

interface SyncResult {
  projectId: number;
  projectName: string;
  success: boolean;
  error?: string;
}

const FeatureSyncManager = () => {
  const { user, currentProject } = useAuth();
  const { toast } = useToast();
  const [features, setFeatures] = useState<Feature[]>([]);
  const [selectedFeature, setSelectedFeature] = useState<string>('');
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [syncResults, setSyncResults] = useState<SyncResult[]>([]);
  const [error, setError] = useState<string | null>(null);

  const isSuperAdmin = user?.isSuperAdmin || false;

  useEffect(() => {
    if (isSuperAdmin) {
      fetchFeatures();
    }
  }, [isSuperAdmin]);

  const fetchFeatures = async () => {
    setIsLoading(true);
    setError(null);
    
    try {
      const response = await apiRequest('GET', '/api/syncable-features');
      const data = await response.json();
      
      if (data.success && data.features) {
        setFeatures(data.features);
      } else {
        setError(data.message || '获取功能列表失败');
      }
    } catch (err) {
      console.error('获取可同步功能失败:', err);
      setError('获取可同步功能失败，请稍后重试');
    } finally {
      setIsLoading(false);
    }
  };

  const handleSyncFeature = async () => {
    if (!selectedFeature || !currentProject) return;
    
    setIsLoading(true);
    setSyncResults([]);
    setError(null);
    
    try {
      const response = await apiRequest('POST', '/api/sync-feature', {
        featureType: selectedFeature,
        sourceProjectId: currentProject.id,
      });
      
      const data = await response.json();
      
      if (data.success) {
        setSyncResults(data.syncedProjects || []);
        toast({
          title: '功能同步成功',
          description: `已将${getFeatureName(selectedFeature)}同步到${data.syncedProjects?.length || 0}个项目`,
        });
      } else {
        setError(data.message || '功能同步失败');
        toast({
          title: '功能同步失败',
          description: data.message || '同步过程中发生错误',
          variant: 'destructive',
        });
      }
    } catch (err) {
      console.error('同步功能失败:', err);
      setError('同步功能失败，请稍后重试');
      toast({
        title: '功能同步失败',
        description: '请求过程中发生错误',
        variant: 'destructive',
      });
    } finally {
      setIsLoading(false);
    }
  };

  const getFeatureName = (featureId: string): string => {
    const feature = features.find(f => f.id === featureId);
    return feature ? feature.name : featureId;
  };

  if (!isSuperAdmin) {
    return null;
  }

  return (
    <div className="space-y-4">
      {error && (
        <Alert variant="destructive" className="mb-4">
          <AlertTriangle className="h-4 w-4" />
          <AlertTitle>错误</AlertTitle>
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}

      <div className="mb-4">
        <label className="block text-sm font-medium mb-2">
          选择要同步的功能
        </label>
        <Select
          value={selectedFeature}
          onValueChange={setSelectedFeature}
          disabled={isLoading}
        >
          <SelectTrigger>
            <SelectValue placeholder="选择功能" />
          </SelectTrigger>
          <SelectContent>
            {features.map((feature) => (
              <SelectItem key={feature.id} value={feature.id}>
                {feature.name}
              </SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>

      <Button
        className="w-full"
        onClick={handleSyncFeature}
        disabled={!selectedFeature || isLoading}
      >
        {isLoading ? (
          <>
            <RefreshCw className="mr-2 h-4 w-4 animate-spin" />
            同步中...
          </>
        ) : (
          <>
            <RefreshCw className="mr-2 h-4 w-4" />
            同步到所有项目
          </>
        )}
      </Button>

      {syncResults.length > 0 && (
        <Card className="mt-4">
          <CardHeader>
            <CardTitle className="text-base">同步结果</CardTitle>
          </CardHeader>
          <CardContent>
            <ul className="space-y-2 max-h-[200px] overflow-y-auto">
              {syncResults.map((result) => (
                <li key={result.projectId} className="flex items-center justify-between border-b pb-2">
                  <span>{result.projectName}</span>
                  {result.success ? (
                    <CheckCircle2 className="h-5 w-5 text-green-500" />
                  ) : (
                    <div className="flex items-center">
                      <XCircle className="h-5 w-5 text-red-500 mr-1" />
                      <span className="text-xs text-red-500">{result.error}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      )}
    </div>
  );
};

export default FeatureSyncManager;