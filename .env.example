# OA System 环境变量示例
#
# 用法：复制成 .env 再填值。.env 已在 .gitignore 里，不会进版本库。
#     cp .env.example .env
#
# 这个文件是部署时唯一的配置入口 —— 下面三个必填项没设，容器直接起不来
# （docker-compose 里用的是 ${VAR:?...} 强制写法，不是给默认值）。
# 这样做是因为「忘了设密码」不该靠人记得：给默认值就会静默用上弱口令。

# ============ 必填 ============

# PostgreSQL 密码。同时用于数据库容器的 POSTGRES_PASSWORD 和应用的 PGPASSWORD。
# 生成：openssl rand -base64 24
DB_PASSWORD=

# JWT 签名密钥。改这个值会让所有已签发的登录令牌立刻失效。
# 生成：openssl rand -base64 48
JWT_SECRET=

# Redis 密码
# 生成：openssl rand -base64 24
REDIS_PASSWORD=

# ============ 可选 ============

# 服务层测试入口开关。默认 0（关闭），此时 /api/test-harness.php 返回 404。
# 生产环境不要打开 —— 它能绕过审批直接写账本。
# 本地跑自动化测试时由 docker-compose.override.yml 打开，该文件不进版本库。
OA_ENABLE_TEST_HARNESS=0

# ============ 部署后必做 ============
#
# 1. 用 admin / admin123 登录后立即改密码 —— 这是写在 init.sql 里的
#    公开默认口令（右上角用户菜单 → 修改密码）。
# 2. 清掉演示数据：全新部署的库里只有一个「演示项目」和它的基础配置，
#    正式启用前请按实际情况重建项目、账户、部门、科目。
# 3. 确认时区：系统按 Asia/Singapore（UTC+8）判断「哪一天」，
#    在 docker-compose.yml 的 TZ / PGTZ / -c timezone 三处设置。
#    使用者不在 UTC+8 时这三处要一起改，只改一处会让新旧数据错开时区。
