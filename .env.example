# OA System Environment Configuration

# Database - PostgreSQL
PGHOST=postgres
PGPORT=5432
PGDATABASE=oa_system
PGUSER=postgres
PGPASSWORD=postgres

# Database - MySQL (alternative)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=oa_system
DB_USER=root
DB_PASSWORD=mysql

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:8000

# PHP Configuration
PHP_ENV=development
APP_DEBUG=true
